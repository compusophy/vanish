# ---- model ----------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-...

# ---- session --------------------------------------------------------
# any long random string. generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- github oauth ---------------------------------------------------
# create at https://github.com/settings/developers -> new oauth app
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# repository the agent is allowed to edit
GITHUB_REPO=compusophy/vanish
GITHUB_BRANCH=main

# comma separated github logins allowed to sign in.
# defaults to the owner of GITHUB_REPO when unset.
ALLOWED_GITHUB_LOGINS=compusophy

# optional: fixed public url. when unset it is derived from the request host.
# PUBLIC_BASE_URL=https://vanish.vercel.app

# optional: personal access token for headless/cron runs with no browser
# GITHUB_TOKEN=

# optional: force a rebuild without a commit
# VERCEL_DEPLOY_HOOK_URL=

# ---- vercel (build feedback) ----------------------------------------
# ALL OPTIONAL. build pass/fail already reaches the agent for free through
# vercel's github commit status, using the github token it already has.
# adding a vercel token upgrades that from "the build failed" to the actual
# build log.
#
# token: https://vercel.com/account/tokens  (scope it to the team below)
VERCEL_TOKEN=
# the project that builds this repo. find it in project settings -> general.
VERCEL_PROJECT_ID=
# required when the project lives under a team rather than a personal account
VERCEL_TEAM_ID=
